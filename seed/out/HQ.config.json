      "scope": "total",
      "formula": "SUM(f03.fund) + SUM(f03.meal) = SUM(emp.c0301, emp.c0303, emp.c0304, emp.c0305, emp.c0306, emp.c0307, emp.c0321, emp.c0309, emp.c0316, emp.c0407M_RE, emp.c0407M_HS, emp.c0404, emp.c0406, emp.c0401, emp.c0416, emp.c0417, emp.c0420)",
      "message": "Quỹ lương thực chi + tiền ăn trên Form 03 ≠ tổng các khoản của bảng nhân viên (Form 03!J1)"
    },
    {
      "id": "meal_total",
