        "placeDate": "TP. Cần Thơ, ngày {=IF(run.group = \"PP1\", \"01\", \"02\")} tháng {=TEXT(MONTH(EOMONTH(DATE(run.year, run.month, 1), 1)), \"00\")} năm {=YEAR(EOMONTH(DATE(run.year, run.month, 1), 1))}",
