{
  "schemaVersion": 1,
  "id": "IN",
  "name": "IN — Trích BHXH, BHYT, BHTN, KPCĐ",
  "ledger": "shared",
  "fileName": "Form_IN_T{MM}.{YYYY}.xlsx",
  "inputs": [
    {
      "id": "SalaryTable",
      "label": "Bảng lương (Salary Table)",
      "required": true,
      "key": "emp_id",
      "fields": [
        {
          "id": "emp_id",
          "label": "Mã NV",
          "type": "text",
          "required": true,
          "aliases": [
            "Mã NV"
          ]
        },
        {
          "id": "dv",
          "label": "ĐV",
          "type": "text",
          "required": false,
          "aliases": [
            "ĐV"
          ]
        },
        {
          "id": "unit",
          "label": "Mã BP",
          "type": "text",
          "required": true,
          "aliases": [
            "Mã BP"
          ]
        },
        {
          "id": "ho",
          "label": "Họ",
          "type": "text",
          "required": false,
          "aliases": [
            "Họ"
          ]
        },
        {
          "id": "ten",
          "label": "Tên",
          "type": "text",
          "required": false,
          "aliases": [
            "Tên"
          ]
        },
        {
          "id": "pctn",
          "label": "PCTN",
          "type": "number",
          "required": false,
          "aliases": [
            "PCTN"
          ]
        },
        {
          "id": "basic",
          "label": "Lương CB",
          "type": "number",
          "required": false,
          "aliases": [
            "Lương CB"
          ]
        },
        {
          "id": "position_coef",
          "label": "Hệ số VT",
          "type": "number",
          "required": false,
          "aliases": [
            "Hệ số VT"
          ]
        },
        {
          "id": "position_salary",
          "label": "Lương VTCV",
          "type": "number",
          "required": false,
          "aliases": [
            "Lương VTCV"
          ]
        },
        {
          "id": "toxic_salary",
          "label": "LgBH.Độc Hại",
          "type": "number",
          "required": false,
          "aliases": [
            "LgBH.Độc Hại"
          ]
        },
        {
          "id": "foreign",
          "label": "Nước ngoài",
          "type": "text",
          "required": false,
          "aliases": [
            "Nước ngoài"
          ]
        },
        {
          "id": "kbhxh",
          "label": "KBHXH",
          "type": "text",
          "required": false,
          "aliases": [
            "KBHXH"
          ]
        },
        {
          "id": "salary_type",
          "label": "Lọai lương",
          "type": "text",
          "required": true,
          "aliases": [
            "Lọai lương",
            "Loại lương"
          ]
        }
      ]
    }
  ],
  "runParams": [
    {
      "id": "hr_manager",
      "label": "Trưởng Phòng Nhân sự (tên in)",
      "type": "text",
      "default": ""
    },
    {
      "id": "reporter",
      "label": "Người đề nghị (tên in)",
      "type": "text",
      "default": ""
    }
  ],
  "employeeTable": {
    "source": "SalaryTable",
    "rowFilter": "IN(LEFT(TRIM([salary_type]), 3), \"(1)\", \"(2)\")",
    "columns": [
      {
        "id": "emp_id",
        "label": "Mã NV",
        "formula": "in.SalaryTable.emp_id",
        "type": "text"
      },
      {
        "id": "dv",
        "label": "Mã ĐV",
        "formula": "in.SalaryTable.dv",
        "type": "text"
      },
      {
        "id": "unit",
        "label": "Mã BP",
        "formula": "in.SalaryTable.unit",
        "type": "text"
      },
      {
        "id": "name",
        "label": "Họ và tên",
        "formula": "TRIM(in.SalaryTable.ho) & \" \" & TRIM(in.SalaryTable.ten)",
        "type": "text"
      },
      {
        "id": "salary_type",
        "label": "Loại lương",
        "formula": "in.SalaryTable.salary_type",
        "type": "text",
        "show": false
      },
      {
        "id": "foreign",
        "label": "Nước ngoài",
        "formula": "IF(in.SalaryTable.foreign = 0, 0, 1)",
        "type": "number",
        "show": false
      },
      {
        "id": "retired",
        "label": "Hưu",
        "formula": "IF([foreign] = 1, 0, IF(in.SalaryTable.kbhxh = \"Checked\", 1, 0))",
        "type": "number",
        "show": false
      },
      {
        "id": "reserve",
        "label": "Lương bảo lưu",
        "formula": "in.SalaryTable.basic",
        "type": "number",
        "show": false
      },
      {
        "id": "vtcv",
        "label": "Lương VTCV x HS",
        "formula": "ROUNDUP(in.SalaryTable.position_salary * IF(in.SalaryTable.position_coef = 0, 1, in.SalaryTable.position_coef), -3)",
        "type": "number",
        "show": false
      },
      {
        "id": "toxic",
        "label": "Lương NNDH",
        "formula": "in.SalaryTable.toxic_salary",
        "type": "number",
        "show": false
      },
      {
        "id": "pctn",
        "label": "PCTN",
        "formula": "in.SalaryTable.pctn",
        "type": "number",
        "show": false
      },
      {
        "id": "ins_salary",
        "label": "Lương BH",
        "formula": "MAX([reserve], [vtcv]) + [toxic] + [pctn]",
        "type": "number"
      },
      {
        "id": "base_si",
        "label": "Mức đóng BHXH",
        "formula": "IF([retired] = 1, 0, IF(OR([foreign] = 1, AND(LEFT([salary_type], 3) <> \"(1)\", LEFT([salary_type], 3) <> \"(2)\")), 0, MIN([ins_salary], P.LCS * 20)))",
        "type": "number"
      },
      {
        "id": "base_hi",
        "label": "Mức đóng BHYT",
        "formula": "IF([retired] = 1, 0, IF(OR([foreign] = 1, AND(LEFT([salary_type], 3) <> \"(1)\", LEFT([salary_type], 3) <> \"(2)\")), 0, MIN([ins_salary], P.LCS * 20)))",
        "type": "number"
      },
      {
        "id": "base_ui",
        "label": "Mức đóng BHTN",
        "formula": "IF([retired] = 1, 0, IF(OR([foreign] = 1, AND(LEFT([salary_type], 3) <> \"(1)\", LEFT([salary_type], 3) <> \"(2)\")), 0, MIN([ins_salary], P.TTV * 20)))",
        "type": "number"
      },
      {
        "id": "si_co",
        "label": "BHXH CTY",
        "formula": "[base_si] * P.BHXH_CTY",
        "type": "number",
        "show": false
      },
      {
        "id": "hi_co",
        "label": "BHYT CTY",
        "formula": "[base_hi] * P.BHYT_CTY",
        "type": "number",
        "show": false
      },
      {
        "id": "ui_co",
        "label": "BHTN CTY",
        "formula": "[base_ui] * P.BHTN_CTY",
        "type": "number",
        "show": false
      },
      {
        "id": "tu_co",
        "label": "KPCD CTY",
        "formula": "[base_si] * P.KPCD_CTY",
        "type": "number",
        "show": false
      },
      {
        "id": "si_emp",
        "label": "BHXH NLD",
        "formula": "ROUND([base_si] * P.BHXH_NLD, 0)",
        "type": "number"
      },
      {
        "id": "hi_emp",
        "label": "BHYT NLD",
        "formula": "ROUND([base_hi] * P.BHYT_NLD, 0)",
        "type": "number"
      },
      {
        "id": "ui_emp",
        "label": "BHTN NLD",
        "formula": "ROUND([base_ui] * P.BHTN_NLD, 0)",
        "type": "number"
      },
      {
        "id": "tu_emp",
        "label": "KPCD NLD",
        "formula": "0",
        "type": "number",
        "show": false
      },
      {
        "id": "c0312",
        "label": "0312",
        "formula": "ROUND([si_co], 0)",
        "type": "number"
      },
      {
        "id": "c0313",
        "label": "0313",
        "formula": "ROUND([hi_co], 0)",
        "type": "number"
      },
      {
        "id": "c0314",
        "label": "0314",
        "formula": "ROUND([tu_co], 0)",
        "type": "number"
      },
      {
        "id": "c0315",
        "label": "0315",
        "formula": "ROUNDUP([ui_co], -1)",
        "type": "number"
      }
    ]
  },
  "costItems": [
    {
      "helper": "0312",
      "costCode": "0312",
